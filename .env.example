# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored.
#
# WARNING: Vite inlines VITE_* vars into the client bundle. Any key here will
# be visible to anyone who inspects the deployed JS. Fine for a prototype —
# for public production, front these with a small backend proxy that holds
# the keys server-side.
#
# ── Supabase (production backend) ────────────────────────────────
# Required. The service layer always talks to Postgres + Auth; the app
# refuses to start without these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. OAuth/magic-link return URL when not using the browser origin (e.g. phone on LAN).
# VITE_SITE_URL=http://localhost:5173
#
# ── Entry-fee / Swish (manual, informational) ────────────────────
# Shown to players on the dashboard as pay-in instructions. Not secret —
# these are displayed in the client. Payment is done manually in the Swish
# app; an admin then marks the player as paid (see supabase/README.md).
# Optional override; client defaults to 0708312041 when unset
VITE_SWISH_NUMBER=
VITE_ENTRY_FEE_SEK=

# ── Server-only secrets (used by scripts/ and supabase/functions/) ─
# Do NOT put VITE_ prefix on these — they must never be bundled to the
# client. Only consumed by node scripts and the Edge Function.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=
FOOTBALL_PROVIDER=football-data
